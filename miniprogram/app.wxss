page {
  background: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  color: #1f2330;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
image {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* 通用按钮 */
.btn-primary {
  background: #1a73e8;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 0;
  line-height: 96rpx;
  height: 96rpx;
}
.btn-primary::after {
  border: none;
}
button.btn-primary[disabled] {
  background: #a8c7f1;
  color: #fff;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 48, 0.05);
}