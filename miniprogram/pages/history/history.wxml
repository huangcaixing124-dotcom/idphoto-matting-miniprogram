<view class="page">
  <block wx:if="{{empty}}">
    <view class="card empty-state">
      <view class="empty-icon">📋</view>
      <view class="empty-title">暂无使用记录</view>
      <view class="empty-sub">处理完证件照后，会在这里看到历史记录</view>
    </view>
  </block>

  <block wx:else>
    <view class="record-item" wx:for="{{records}}" wx:key="time">
      <view class="record-main">
        <view class="record-size">{{item.size}}</view>
        <view class="record-color" wx:if="{{item.color}}">底色 {{item.color}}</view>
        <view class="record-hd" wx:else>{{item.hd ? '高清' : '普通'}}</view>
      </view>
      <view class="record-time">{{item.timeText}}</view>
    </view>
    <view class="clear-btn" bindtap="onClear">清空记录</view>
  </block>
</view>