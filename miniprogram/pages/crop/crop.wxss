.page {
  min-height: 100vh;
  background: #1a1d26;
  padding: 24rpx;
  padding-bottom: 280rpx;
}

.canvas-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #242833;
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 420rpx;
}
.crop-canvas {
  background: #000;
  border-radius: 8rpx;
}

.tips {
  text-align: center;
  color: #8a94a6;
  font-size: 26rpx;
  margin-top: 24rpx;
}

/* 底部操作栏 */
.toolbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.row-label {
  font-size: 26rpx;
  color: #1f2330;
  width: 100rpx;
  flex-shrink: 0;
}

/* 规格横滑 */
.spec-scroll {
  white-space: nowrap;
  flex: 1;
}
.spec-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #f0f1f5;
  color: #1f2330;
  border-radius: 32rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.spec-chip.active {
  background: #1a73e8;
  color: #fff;
}

/* 模式切换 */
.mode-toggle {
  display: flex;
  background: #f0f1f5;
  border-radius: 32rpx;
  padding: 4rpx;
}
.mode-btn {
  padding: 10rpx 36rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #8a94a6;
}
.mode-btn.on {
  background: #fff;
  color: #1a73e8;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 操作按钮 */
.actions {
  margin-top: 8rpx;
}
.btn-ghost {
  flex: 1;
  background: #f0f1f5;
  color: #1f2330;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
}
.btn-primary-small {
  flex: 2;
  background: #1a73e8;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
}
button::after {
  border: none;
}

.hint {
  text-align: center;
  font-size: 24rpx;
  color: #8a94a6;
  margin-top: 12rpx;
}