<view class="page">
  <view class="canvas-wrap">
    <canvas
      type="2d"
      id="cropCanvas"
      class="crop-canvas"
      style="width:{{canvasW}}px;height:{{canvasH}}px;"
    ></canvas>
  </view>

  <view class="tips" wx:if="{{!hasImage}}">加载中…</view>

  <!-- 底部操作栏 -->
  <view class="toolbar" wx:if="{{hasImage}}">
    <!-- 规格选择 -->
    <view class="row">
      <view class="row-label">规格</view>
      <scroll-view scroll-x class="spec-scroll">
        <view
          wx:for="{{specs}}"
          wx:key="id"
          class="spec-chip {{selectedSpecId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectSpec"
        >{{item.name}}</view>
      </scroll-view>
    </view>

    <view class="row actions">
      <button class="btn-ghost" bindtap="onBackToEdit">返回改底</button>
      <button class="btn-primary-small" bindtap="onExport">生成并保存</button>
    </view>
  </view>
</view>