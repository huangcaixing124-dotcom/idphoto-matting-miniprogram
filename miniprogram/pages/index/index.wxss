.page {
  padding: 24rpx 32rpx 48rpx;
  padding-bottom: 120rpx;
}

/* 顶部横幅 */
.hero {
  background: linear-gradient(135deg, #1a73e8, #4a90e2);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  color: #fff;
  margin-bottom: 32rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.hero-sub {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}
/* 卡片标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* 规格选择 - 分类 Tab */
.group-tabs {
  display: flex;
  background: #f2f4f8;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}
.group-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.group-tab.active {
  background: #fff;
  color: #1a73e8;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(26, 115, 232, 0.12);
}

/* 规格网格卡片（三列；场景文字填卡片内部，多行小字） */
.spec-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.spec-card {
  width: 31.5%;
  padding: 24rpx 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
  background: #f5f6fa;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.spec-card.active {
  background: #eaf1fe;
  border-color: #1a73e8;
}
.spec-card.active .spec-name {
  color: #1a73e8;
}
.spec-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2330;
}
.spec-size {
  font-size: 20rpx;
  color: #8a94a6;
  margin-top: 6rpx;
}
.spec-scene {
  font-size: 20rpx;
  color: #6b7280;
  margin-top: 10rpx;
  line-height: 1.5;
  padding: 0 6rpx;
  word-break: break-all; /* 窄卡片内长文案换行 */
}
.choose-btn {
  margin-top: 8rpx;
}

/* 功能列表 */
.func-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}
.func-row:last-child {
  border-bottom: none;
}
.func-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1a73e8;
  margin-right: 20rpx;
}
.func-text {
  display: flex;
  flex-direction: column;
}
.func-name {
  font-size: 28rpx;
  font-weight: 500;
}
.func-sub {
  font-size: 24rpx;
  color: #8a94a6;
  margin-top: 4rpx;
}
/* 分享给好友按钮 */
.btn-share {
  width: 100%;
  margin-top: 24rpx;
  background: #eaf1fe;
  color: #1a73e8;
  border: 2rpx solid #1a73e8;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
}
.btn-share::after { border: none; }
